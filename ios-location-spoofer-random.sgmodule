#!name=iOS Location Spoofer Random
#!desc=iOS Location Spoofer - Random 1-3m
#!homepage=https://github.com/EBISU1995/ios-location-random

[Script]
iOS Location Spoofer Random = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc,requires-body=1,binary-body-mode=1,max-size=0,timeout=30,script-path=https://raw.githubusercontent.com/EBISU1995/ios-location-random/main/location-spoofer-random.js,argument=mode=response&latitude=21.0001875&longitude=105.8016875&horizontalAccuracy=39&verticalAccuracy=1000&altitude=530&random=true&randomMin=1&randomMax=3&randomInterval=300&debug=false

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
